{
  "name": "pi-engine",
  "version": "0.1.0",
  "description": "Open source 3D engine optimized for Raspberry Pi 4/5 (Vulkan, C++20).",
  "homepage": "https://github.com/",
  "dependencies": [
    "vulkan-headers",
    "volk",
    "vulkan-memory-allocator",
    {
      "name": "sdl2",
      "features": ["vulkan"]
    },
    "glm",
    "joltphysics",
    {
      "name": "imgui",
      "features": ["docking-experimental"]
    },
    "doctest",
    "nlohmann-json",
    "shaderc",
    "meshoptimizer"
  ]
}
